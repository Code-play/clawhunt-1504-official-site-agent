{
  "schema_version": "1.0",
  "note": "转人工路由：按门控分支决定进入哪个队列、SLA 与优先级。分支未单独配置时落到 default_route。",
  "routes": [
    {
      "id": "RT-NOHIT",
      "match": { "branch": "handoff_no_hit" },
      "queue": "human-l1",
      "sla_hours": 4,
      "priority": "normal",
      "note": "未知问题：知识库无相关条目，转一线人工"
    },
    {
      "id": "RT-LOWCONF",
      "match": { "branch": "handoff_low_confidence" },
      "queue": "human-l2-specialist",
      "sla_hours": 2,
      "priority": "high",
      "note": "低置信度：有相关条目但证据不足，转专家复核"
    },
    {
      "id": "RT-RATELIMIT",
      "match": { "branch": "rate_limited" },
      "queue": "security-abuse",
      "sla_hours": 1,
      "priority": "high",
      "note": "触发限流：转安全队列，防止刷问与滥用"
    }
  ],
  "tag_routes": [
    {
      "match_tag": "billing",
      "queue": "billing-team",
      "sla_hours": 8,
      "priority": "normal",
      "note": "示例：命中计费类标签时可直接路由到计费组（需在编排层启用）"
    }
  ],
  "default_route": {
    "id": "RT-DEFAULT",
    "queue": "human-l1",
    "sla_hours": 8,
    "priority": "normal",
    "note": "兜底路由"
  }
}
